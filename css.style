/* Reset & Variabel Warna (Theme: Dark Modern / Teen Energetic) */
:root {
  --bg-color: #0f172a;
  --card-bg: #1e293b;
  --primary: #6366f1;
  --primary-hover: #4f46e5;
  --accent: #10b981;
  --danger: #ef4444;
  --text: #f8fafc;
  --text-muted: #94a3b8;
  --border-radius: 16px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
  background-color: var(--bg-color);
  color: var(--text);
  display: flex;
  justify-content: center;
  padding: 16px;
  min-height: 100vh;
}

.app-container {
  width: 100%;
  max-width: 480px; /* Tampilan optimal seluler & desktop tengah */
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* Header */
.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
}

.logo {
  display: flex;
  align-items: center;
  gap: 8px;
}

.logo h1 {
  font-size: 1.5rem;
  font-weight: 700;
  background: linear-gradient(135deg, #a5b4fc, #6366f1);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.streak-badge {
  background-color: #334155;
  padding: 6px 12px;
  border-radius: 20px;
  font-weight: bold;
  font-size: 0.9rem;
  border: 1px solid #475569;
}

.offline-notice {
  background-color: #f59e0b;
  color: #000;
  text-align: center;
  padding: 8px;
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: bold;
}

.hidden {
  display: none;
}

/* Cards */
.card {
  background-color: var(--card-bg);
  border-radius: var(--border-radius);
  padding: 18px;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
  border: 1px solid #334155;
}

.card h2, .card h3 {
  font-size: 1.1rem;
  margin-bottom: 12px;
  color: var(--text);
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 16px;
}

.stat-box {
  background-color: #0f172a;
  padding: 12px;
  border-radius: 12px;
  border: 1px solid #334155;
}

.stat-box small {
  color: var(--text-muted);
  font-size: 0.75rem;
}

.stat-value {
  font-size: 1.2rem;
  font-weight: bold;
  margin-top: 4px;
}

.stat-value.highlight {
  color: var(--accent);
}

/* Target & Progress Bar */
.target-section {
  background-color: #0f172a;
  padding: 12px;
  border-radius: 12px;
}

.target-header {
  display: flex;
  justify-content: space-between;
  font-size: 0.85rem;
  margin-bottom: 8px;
}

.progress-bar-bg {
  width: 100%;
  height: 10px;
  background-color: #334155;
  border-radius: 5px;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #10b981, #34d399);
  transition: width 0.4s ease;
}

/* Forms */
.form-group {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

label {
  font-size: 0.8rem;
  color: var(--text-muted);
}

input, select {
  width: 100%;
  padding: 10px 12px;
  border-radius: 8px;
  border: 1px solid #334155;
  background-color: #0f172a;
  color: var(--text);
  font-size: 0.9rem;
}

input:focus, select:focus {
  outline: none;
  border-color: var(--primary);
}

details summary {
  cursor: pointer;
  margin-bottom: 12px;
}

/* Buttons */
.btn {
  width: 100%;
  padding: 12px;
  border: none;
  border-radius: 8px;
  font-weight: bold;
  cursor: pointer;
  transition: opacity 0.2s;
  margin-top: 6px;
}

.btn:hover {
  opacity: 0.9;
}

.btn-primary {
  background-color: var(--primary);
  color: white;
}

.btn-action {
  background-color: var(--accent);
  color: white;
}

.btn-danger {
  background-color: transparent;
  color: var(--danger);
  border: 1px solid var(--danger);
  margin-top: 12px;
}

/* Badges */
.badges-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.badge-item {
  background-color: #0f172a;
  border: 1px solid #334155;
  border-radius: 12px;
  padding: 10px;
  text-align: center;
  opacity: 0.4;
  filter: grayscale(100%);
  transition: all 0.3s ease;
}

.badge-item.unlocked {
  opacity: 1;
  filter: grayscale(0%);
  border-color: var(--accent);
}

.badge-icon {
  font-size: 1.5rem;
  display: block;
}

.badge-name {
  font-size: 0.7rem;
  font-weight: bold;
  margin-top: 4px;
}

/* History List */
.history-list {
  list-style: none;
  max-height: 200px;
  overflow-y: auto;
}

.history-item {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid #334155;
  font-size: 0.85rem;
}

.empty-msg {
  text-align: center;
  color: var(--text-muted);
  font-size: 0.85rem;
  padding: 12px 0;
}
